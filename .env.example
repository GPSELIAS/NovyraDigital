# ─────────────────────────────────────────────────────────────
# Novyra Digital – Umgebungsvariablen
# ─────────────────────────────────────────────────────────────
# FRONTEND (öffentlich, landet im Build – KEINE Geheimnisse!)
# Lokal in `.env.local` setzen.
# Produktiv: Site Key in src/config/site.ts (turnstileSiteKey) eintragen.
# Lokal (Datei .env.local): Cloudflare-Testschlüssel, der immer besteht:
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# SERVER (Cloudflare Pages Functions) – lokal in `.dev.vars`,
# produktiv im Cloudflare-Dashboard als Secret bzw. Variable.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx           # Secret
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   # Secret (hier: Cloudflare-Testschlüssel)
MAIL_TO=info@novyradigital.ch
MAIL_FROM="Novyra Digital <website@mail.novyradigital.ch>"   # Domain muss in Resend verifiziert sein
SEND_CONFIRMATION_EMAIL=false                        # true = Eingangsbestätigung an Anfragende
ALLOWED_ORIGINS=https://novyradigital.ch,https://www.novyradigital.ch
